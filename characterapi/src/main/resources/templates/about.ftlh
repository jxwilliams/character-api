<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>About</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

<nav class="nav">
  <a href="/characters">Home</a>
  <a href="/characters/about">About</a>
  <a href="/characters/create">Form</a>
</nav>

<header class="header">
  <h1>About This Site</h1>
  <p class="sub">A small Spring Boot project for browsing and creating comic characters.</p>
</header>

<main class="main">
  <article class="card detail-card">
    <div class="content">
      <p class="desc">
        This website was created for an assignment and now runs as a server-rendered Spring Boot app with FreeMarker templates.
      </p>

      <p class="desc">
        You can browse characters, open an individual details page, and add a new character through the form page.
      </p>

      <p class="detail-actions">
        <a class="button-link" href="/characters">Back to Home</a>
      </p>
    </div>
  </article>
</main>

</body>
</html>
